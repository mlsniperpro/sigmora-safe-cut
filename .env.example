# Copy to .env (never commit it). Every variable is optional except MODEL_API_KEY for live calls.
# Defaults live in safecut/config.py; this file lists them for reference.

# Meta Model API key (Standard mode). Secret: never print or commit it.
MODEL_API_KEY=
SAFECUT_META_BASE_URL=https://api.meta.ai/v1

# Models (AGENTS rule 8: IDs come from env; -contributor IDs are refused)
SAFECUT_SAM_MODEL=sam-3.1
SAFECUT_ROLE_MODEL=muse-spark-1.3
SAFECUT_ROLE_EFFORT=medium
SAFECUT_SCENE_MODEL=muse-spark-1.3
SAFECUT_SCENE_EFFORT=medium
SAFECUT_ESCALATE_MODEL=muse-spark-1.3
SAFECUT_ESCALATE_EFFORT=max
SAFECUT_REDTEAM_MODEL=muse-spark-1.3
SAFECUT_REDTEAM_EFFORT=medium
SAFECUT_ASR_MODEL=muse-voice-transcribe-1.0
SAFECUT_SPEECH_SOURCE=asr
SAFECUT_SPEECH_FALLBACK_MODEL=muse-spark-1.2
SAFECUT_SPEECH_FALLBACK_EFFORT=omit
SAFECUT_ASR_LANGUAGE_BIAS=["English"]
SAFECUT_SAM_SEND_STORE=true

# Spend guards (USD)
SAFECUT_JOB_USD_CAP=3.00
SAFECUT_DAILY_USD_CAP=3.00
SAFECUT_PILOT_CODE_USD=6.00
SAFECUT_PILOT_POOL_USD=20
SAFECUT_RECORDING_CODE_USD=15.00
SAFECUT_TEST_LINE_USD=43.20

# Pipeline
SAFECUT_SAM_FPS=8
SAFECUT_MISS_SAM=live
SAFECUT_REPLAY=0

# Access (JSON). Codes: [{"code": "...", "kind": "judge|public|pilot|recording|owner", "cap_usd": 6.0}]
SAFECUT_ACCESS_CODES=[]
SAFECUT_SERVICE_KEYS=[]
# SAFECUT_CODE_WINDOWS={"judge": ["2026-11-05T00:00:00Z", "2026-11-10T23:59:59Z"]}

# Auditor
SAFECUT_EGOBLUR_MODEL=egoblur-gen2
SAFECUT_EGOBLUR_WEIGHTS_DIR=/models/egoblur
SAFECUT_EGOBLUR_FACE_THRESHOLD=0.5
SAFECUT_EGOBLUR_PLATE_THRESHOLD=0.5

# Upload storage (WP5, secrets)
SAFECUT_R2_ACCOUNT_ID=
SAFECUT_R2_ACCESS_KEY_ID=
SAFECUT_R2_SECRET_ACCESS_KEY=
SAFECUT_R2_BUCKET=
